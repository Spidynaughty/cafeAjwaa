# Uploaded files are data, never code. Block every executable handler.
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
<FilesMatch "\.(php|phtml|php[0-9]|phps|pl|py|jsp|asp|sh|cgi)$">
    Require all denied
</FilesMatch>
